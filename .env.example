# CyberSentinel AI Environment Variables

# Backend Configuration
SECRET_KEY=cybersentinel_secret_key_change_in_production_32bytes!
DATABASE_URL=sqlite:///./cybersentinel.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/cybersentinel
REDIS_URL=redis://localhost:6379/0

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Security & CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live-events
